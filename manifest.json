{
  "manifest_version": 3,
  "name": "Pro Downloader for SoundCloud — HD Cover & Tags",
  "version": "1.1.1",
  "description": "Download SoundCloud tracks as MP3 or M4A with HD cover art and full tags (title, artist, genre, year) embedded automatically.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Pro Downloader for SoundCloud"
  },
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.soundcloud.com/*",
    "*://*.sndcdn.com/*",
    "*://*.soundcloud.cloud/*",
    "*://*.soundclouddownloader.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.soundcloud.com/*"
      ],
      "js": [
        "lib/tagger.js",
        "lib/api.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "SC Pro Downloader"
}